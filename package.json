{
  "name": "ws-components-sample",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "esbuild"
  ],
  "engines": {
    "node": ">=24.21.0",
    "bun": ">=1.4.2"
  },
  "volta": {
    "node": "24.21.0"
  },
  "scripts": {
    "build": "bun run --workspaces --if-present build",
    "dev:react": "bun run --filter ./apps/react dev",
    "dev:vue": "bun run --filter ./apps/vue dev",
    "dev:react:ssr": "bun run --filter ./apps/react dev:ssr",
    "dev:vue:ssr": "bun run --filter ./apps/vue dev:ssr",
    "dev:native": "bun run --filter ./apps/native dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  }
}
