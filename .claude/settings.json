{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun install)",
      "Bash(bun install --frozen-lockfile)",
      "Bash(bun run lint)",
      "Bash(bun run lint:fix)",
      "Bash(bun run format)",
      "Bash(bun run build)",
      "Bash(bun run dev:*)",
      "Bash(bun run test:*)",
      "Bash(bun run --filter:*)",
      "Bash(bun run --cwd packages/ui vitest:*)",
      "Bash(E2E_SITE=* bun run test:e2e:*)",
      "Bash(bunx biome:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_resize",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_click",
      "mcp__playwright__browser_hover",
      "mcp__playwright__browser_press_key",
      "mcp__playwright__browser_wait_for",
      "mcp__playwright__browser_console_messages",
      "mcp__playwright__browser_emulate_media",
      "mcp__playwright__browser_close"
    ],
    "deny": [
      "Read(**/node_modules/**)",
      "Read(**/dist/**)",
      "Read(**/build/**)",
      "Read(**/.output/**)",
      "Read(**/.nuxt/**)",
      "Read(**/.react-router/**)",
      "Read(**/storybook-static/**)",
      "Read(**/test-results/**)",
      "Read(**/playwright-report/**)",
      "Read(**/bun.lock)",
      "Read(.playwright-mcp/**/*.log)",
      "Read(.playwright-mcp/**/*.yml)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(rm -rf*)",
      "Bash(gh repo delete*)",
      "Bash(bun publish*)",
      "Bash(npm publish*)"
    ]
  }
}
